generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DIALOGUE
  PROPOSAL_SENT
  WAITING_DECISION
  WON
  LOST
}

enum LeadSource {
  AVITO
  YOUDO
  WEBSITE
  REFERRAL
  OTHER
}

enum BuyerType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum DealStatus {
  NEW
  WAITING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSTALLMENT
}

enum ScriptCategory {
  GREETING
  PRICE
  DELIVERY
  WARRANTY
  OBJECTION
  CLOSING
  OTHER
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
}

enum NotificationType {
  SLA_BREACH
  FOLLOW_UP_DUE
  DEAL_STATUS_CHANGED
  DAILY_DIGEST
}

enum DeliveryQuoteSource {
  MANUAL
  AI_ESTIMATE
}

model Tenant {
  id                       String   @id @default(cuid())
  name                     String
  timezone                 String   @default("Europe/Samara")
  slaMinutes               Int      @default(15)
  legalEntityMarkupPercent Decimal  @default(20) @db.Decimal(5, 2)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())

  users           User[]
  categories      Category[]
  products        Product[]
  warehouses      Warehouse[]
  deliveryOptions DeliveryOption[]
  deliveryQuotes  DeliveryQuote[]
  scripts         ScriptTemplate[]
  leads           Lead[]
  deals           Deal[]
  payouts         Payout[]
  notifications   Notification[]
  activityLogs    ActivityLog[]

  @@map("tenants")
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email              String
  passwordHash       String
  fullName           String
  role               Role     @default(MANAGER)
  telegramChatId     String?
  baseSalary         Decimal  @default(0) @db.Decimal(10, 2)
  commissionPercent  Decimal  @default(0) @db.Decimal(5, 2)
  maxDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assignedLeads       Lead[]               @relation("AssignedManager")
  deals               Deal[]
  payouts             Payout[]
  createdScripts      ScriptTemplate[]
  notifications       Notification[]
  activityLogs        ActivityLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String

  products Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name      String
  sku       String?
  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)
  weightKg  Decimal? @db.Decimal(6, 2)
  specs     Json?
  imageUrls String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks    Stock[]
  dealItems DealItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  city     String
  address  String?
  isActive Boolean @default(true)

  stocks Stock[]
  deals  Deal[]
  quotes DeliveryQuote[]

  @@index([tenantId, city])
  @@map("warehouses")
}

model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("stocks")
}

model DeliveryOption {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal @db.Decimal(10, 2)
  etaDays    Int?
  conditions String?

  deals Deal[]

  @@index([tenantId])
  @@map("delivery_options")
}

model DeliveryQuote {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  destinationCity String
  weightKg        Decimal?            @db.Decimal(6, 2)
  cost            Decimal             @db.Decimal(10, 2)
  etaDaysMin      Int
  etaDaysMax      Int
  source          DeliveryQuoteSource
  isApproximate   Boolean             @default(true)
  rawResponse     Json?
  createdAt       DateTime            @default(now())

  deal Deal?

  @@index([tenantId, warehouseId, destinationCity])
  @@map("delivery_quotes")
}

model ScriptTemplate {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ScriptCategory
  title       String
  content     String
  isActive    Boolean        @default(true)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([tenantId, category])
  @@map("script_templates")
}

model Lead {
  id                String @id @default(cuid())
  tenantId          String
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedManagerId String?
  assignedManager   User?  @relation("AssignedManager", fields: [assignedManagerId], references: [id])

  fullName   String?
  phone      String?
  city       String?
  source     LeadSource @default(AVITO)
  sourceLink String?
  status     LeadStatus @default(NEW)
  notes      String?

  buyerType   BuyerType @default(INDIVIDUAL)
  companyName String?
  inn         String?

  firstResponseAt DateTime?
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())

  deals Deal[]

  @@index([tenantId, status])
  @@index([tenantId, assignedManagerId])
  @@map("leads")
}

model Deal {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id])
  managerId String
  manager   User   @relation(fields: [managerId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  deliveryOptionId String?
  deliveryOption   DeliveryOption? @relation(fields: [deliveryOptionId], references: [id])
  deliveryQuoteId  String?         @unique
  deliveryQuote    DeliveryQuote?  @relation(fields: [deliveryQuoteId], references: [id])
  deliveryCost     Decimal         @default(0) @db.Decimal(10, 2)

  discount           Decimal        @default(0) @db.Decimal(10, 2)
  requiresVatInvoice Boolean        @default(false)
  legalEntityMarkup  Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal        @db.Decimal(10, 2)
  paymentMethod      PaymentMethod?
  status             DealStatus     @default(NEW)

  commissionPercentSnap Decimal @db.Decimal(5, 2)
  commissionAmount      Decimal @db.Decimal(10, 2)

  items DealItem[]

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, managerId])
  @@index([leadId])
  @@index([payoutId])
  @@map("deals")
}

model DealItem {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  @@index([dealId])
  @@index([productId])
  @@map("deal_items")
}

model Payout {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  managerId String
  manager   User   @relation(fields: [managerId], references: [id])

  periodStart     DateTime
  periodEnd       DateTime
  baseSalary      Decimal      @db.Decimal(10, 2)
  totalCommission Decimal      @db.Decimal(10, 2)
  totalPayout     Decimal      @db.Decimal(10, 2)
  status          PayoutStatus @default(DRAFT)
  emailSentAt     DateTime?

  deals      Deal[]
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([tenantId, managerId, periodStart])
  @@map("payouts")
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  type      NotificationType
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("activity_logs")
}
