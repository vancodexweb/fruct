# === App ===
NODE_ENV=
PORT=

# === Database ===
DATABASE_URL=

# === Redis (cache + BullMQ) ===
REDIS_URL=

# === JWT ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional, sensible defaults are used when unset (access: 15m, refresh: 30d).
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# === DeepSeek (delivery cost estimation) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# === Telegram (manager notifications) ===
TELEGRAM_BOT_TOKEN=

# === Deployment / TLS (docker-compose.prod.yml + Caddy) ===
DOMAIN=
ACME_EMAIL=

# === First-run bootstrap (see prisma/seed.ts) ===
TENANT_NAME=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
# Leave empty to auto-generate a random password, which is then emailed to
# ADMIN_EMAIL and never logged or printed anywhere.
ADMIN_INITIAL_PASSWORD=

# === SMTP (nodemailer) ===
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
