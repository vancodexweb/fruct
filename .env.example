# === App ===
NODE_ENV=
PORT=

# === Database ===
# For docker-compose.dev.yml: ignored — the dev stack hardcodes its own
# throwaway fruct/fruct/fruct_dev credentials directly in that file.
# For docker-compose.prod.yml: leave DATABASE_URL itself empty — it's built
# automatically from the three POSTGRES_* values below, which also bootstrap
# the postgres container itself, so the credentials only need to be set once.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# === Redis (cache + BullMQ) ===
REDIS_URL=

# === JWT ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional, sensible defaults are used when unset (access: 15m, refresh: 30d).
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# === DeepSeek (delivery cost estimation) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# === Telegram (manager notifications) ===
TELEGRAM_BOT_TOKEN=

# === Deployment / TLS (docker-compose.prod.yml + Caddy) ===
DOMAIN=
ACME_EMAIL=

# Not in the original spec's env list — added because this project is
# backend-only, so the password-reset email can't know where a frontend's
# reset-password page actually lives. Leave empty and it falls back to
# https://$DOMAIN, then to localhost for local dev; see
# src/auth/build-password-reset-url.ts. Set this once a frontend exists.
PASSWORD_RESET_URL_BASE=

# === First-run bootstrap (see prisma/seed.ts) ===
TENANT_NAME=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
# Leave empty to auto-generate a random password, which is then emailed to
# ADMIN_EMAIL and never logged or printed anywhere.
ADMIN_INITIAL_PASSWORD=

# === SMTP (nodemailer) ===
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
